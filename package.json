{
  "name": "scriptorium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Server-authoritative writing provenance tool. The server — never the client — is the authoritative record of how a document was built.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:client": "node apps/server/esbuild.mjs",
    "dev": "tsx watch apps/server/src/index.ts",
    "start": "tsx apps/server/src/index.ts",
    "migrate": "tsx apps/server/src/db/migrate.ts",
    "verify": "tsx apps/server/src/cli/verify.ts",
    "retention": "tsx apps/server/src/cli/retention.ts",
    "lti": "tsx apps/server/src/cli/lti.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test packages/core/test/*.test.ts apps/server/test/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
